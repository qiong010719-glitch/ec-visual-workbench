# Image requests exclusively use this dedicated key. Do not use the model key here.
SUANZHOU_IMAGE_API_KEY=
SUANZHOU_IMAGE_BASE_URL=https://api.suanzhou.vip/v1
SUANZHOU_IMAGE_MODEL=gpt-image-2
# Optional proxy for generated-image downloads only; use the port of your local proxy.
# Proxy support requires Node.js >=24.5. Leave empty for a direct connection.
IMAGE_DOWNLOAD_PROXY=
# Optional reasoning provider. Set the general text/vision key, never the image key.
# Without all three PLANNER settings, planning uses local rules.
PLANNER_BASE_URL=https://api.suanzhou.vip/v1
PLANNER_API_KEY=
PLANNER_MODEL=gpt-6.1-sol
# Optional reasoning effort; leave empty to use the provider default.
PLANNER_REASONING_EFFORT=
# Maximum wait for one complete plan (configured here for 10 minutes).
# Provider/network deadlines may be shorter. Timeout never automatically resubmits.
PLANNER_TIMEOUT_MS=600000
# Pin the vision model independently so changing the planner does not switch analysis.
# VISION_API_KEY may use the general text/vision key; blank falls back to
# PLANNER_API_KEY, then SUANZHOU_API_KEY. Never use the dedicated image key here.
VISION_BASE_URL=https://api.suanzhou.vip/v1
VISION_API_KEY=
VISION_MODEL=gpt-5.4-mini
# Apify token may instead be set in .env.apify (read on each request, no restart needed).
APIFY_API_TOKEN=
PORT=4173
# Shared planning/image/download queue. Current staged rollout: 3; use 2 to roll back.
IMAGE_CONCURRENCY=3
