{
  "name": "ec-visual-workbench-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node tools/start-primary-workbench.mjs",
    "dev": "node --watch tools/start-primary-workbench.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node tools/check-source.mjs",
    "desktop": "node tools/start-primary-desktop.mjs",
    "build:desktop": "electron-builder --config desktop/builder.cjs --win portable"
  },
  "dependencies": {
    "sharp": "^0.35.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright": "^1.65.1"
  },
  "main": "desktop/main.cjs",
  "description": "跨境电商内容制作与上架工作台",
  "author": "Workbench"
}
